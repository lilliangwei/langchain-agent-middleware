#.env.example —— 复制为 .env 并填入真实密钥（.env 已入 .gitignore，切勿提交）

# ===== 模型厂商密钥（多密钥逗号分隔，未配置的厂商自动跳过）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ===== 模型名 / 档位覆盖（可选）=====
# DEEPSEEK_MODEL=deepseek-chat
# QWEN_MODEL=qwen-plus
# ZHIPU_MODEL=glm-4-flash
# MOONSHOT_MODEL=moonshot-v1-8k
# ZHIPU_TIER=complex

# ===== 本地 Ollama（可选，不启动则自动降级云端）=====
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_VISION_MODEL=minicpm-v

# ===== 路由 =====
ROUTER_COMPLEX_THRESHOLD=3

# ===== Embedding（qwen=通义v3 1024维 / ollama=本地768维；切换须清空 data/chroma_db 重新摄入）=====
EMBEDDING_PROVIDER=qwen

# ===== 记忆系统 =====
ENABLE_MEMORY=true
MEMORY_BACKEND=memory
AGENT_SESSION_ID=default
MEMORY_SUMMARY_TOKEN_THRESHOLD=2000
MEMORY_KEEP_RECENT=4

# ===== Redis（MEMORY_BACKEND=redis 时配置）=====
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ===== 联网搜索工具（火山引擎豆包搜索）=====
VOLC_SEARCH_API_KEY=
VOLC_SEARCH_BASE_URL=https://open.feedcoopapi.com/search_api/web_search

# ===== RAG =====
RAG_TOP_K=4
ENABLE_OCR=false

# ===== 计费/缓存 =====
TOKEN_USAGE_LOG=./data/token_usage.jsonl
QUERY_CACHE_TTL_SECONDS=604800
# MODEL_PRICES_JSON={"deepseek-chat": {"input": 2, "output": 8}}

# ===== 通用 =====
DEFAULT_TIMEOUT=60
GLOBAL_MAX_CONCURRENT=8
